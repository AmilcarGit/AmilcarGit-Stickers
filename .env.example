# --- Firebase (cliente) ---
# Consola de Firebase > Configuración del proyecto > Tus apps > App web.
# Son claves públicas por diseño; la seguridad la dan las reglas de Firestore.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Vercel Blob (servidor) ---
# Vercel > Storage > Blob > crear store. Se agrega solo al conectar el store al proyecto.
BLOB_READ_WRITE_TOKEN=

# --- Sitio ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
