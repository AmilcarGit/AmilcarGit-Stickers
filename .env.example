# Copia este archivo a .env.local para desarrollar. En Vercel se cargan en
# Project > Settings > Environment Variables. NUNCA subas valores reales al repositorio.

# --- Base de datos: Upstash Redis (guarda usuarios, sesiones, proyectos, paquetes) ---
# Upstash > tu base de datos > REST API.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Sesiones ---
# Cadena aleatoria de 32+ caracteres que firma las sesiones. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# --- Moderación ---
# Correos (separados por comas) con permiso de moderar. Deben estar verificados.
ADMIN_EMAILS=

# --- Correo (verificación de cuenta y recuperar contraseña) ---
# URL SMTP, por ejemplo smtps://usuario:clave@smtp.tuproveedor.com:465
# Sin esto, el registro funciona pero NO se puede verificar el correo ni recuperar la contraseña.
SMTP_URL=
EMAIL_FROM="AmilcarGit Stickers <no-reply@tudominio.com>"

# --- Archivos: Vercel Blob (stickers publicados y fotos de perfil) ---
# Vercel > Storage > Blob > crear store. Se agrega solo al conectar el store al proyecto.
BLOB_READ_WRITE_TOKEN=

# --- Sitio ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
