# Copia este archivo a .env.local para desarrollar. En Vercel se cargan en
# Project > Settings > Environment Variables. NUNCA subas valores reales al repositorio.

# --- Base de datos: Upstash Redis (guarda usuarios, sesiones, proyectos, paquetes) ---
# Upstash > tu base de datos > REST API.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Sesiones ---
# Cadena aleatoria de 32+ caracteres que firma las sesiones. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# --- Moderación ---
# Correos (separados por comas) con permiso de moderar. Deben estar verificados.
ADMIN_EMAILS=

# --- Correo (verificación de cuenta y recuperar contraseña) ---
# Gmail: smtps://amilcargit%40gmail.com:CONTRASENA_DE_APLICACION_URL_ENCODED@smtp.gmail.com:465
# Reemplaza el marcador por tu contraseña de aplicación (codificada para URL).
# No pongas esta contraseña en el repositorio ni en NEXT_PUBLIC_*.
# También puedes usar otro proveedor SMTP: smtps://usuario:clave@host:465
# Sin SMTP_URL y EMAIL_FROM no se pueden verificar cuentas ni recuperar contraseñas.
SMTP_URL=
EMAIL_FROM="YuiApi <amilcargit@gmail.com>"
