rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function validUsername(u) { return u is string && u.matches('^[a-z0-9_]{3,20}$'); }

    // Administradores: se crean a mano desde la consola de Firebase. Nadie puede escribir desde la app.
    match /admins/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin() || resource.data.profilePublic == true;
      allow create: if isOwner(uid)
        && validUsername(request.resource.data.username)
        && request.resource.data.stickerCount == 0
        && request.resource.data.packCount == 0
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 60;
      allow update: if isOwner(uid)
        && request.resource.data.username == resource.data.username
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.displayName.size() <= 60
        && request.resource.data.bio.size() <= 280;
      allow delete: if false;
    }

    // Un nombre de usuario solo se puede crear una vez y debe coincidir con el perfil que se crea.
    match /usernames/{name} {
      allow read: if true;
      allow create: if signedIn()
        && validUsername(name)
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == name;
      allow update, delete: if false;
    }

    match /projects/{id} {
      allow read: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80;
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name.size() <= 80;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /packs/{id} {
      allow read: if resource.data.listed == true
        || (signedIn() && resource.data.ownerId == request.auth.uid)
        || isAdmin();

      allow create: if verified()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 60
        && request.resource.data.stickers.size() >= 3
        && request.resource.data.stickers.size() <= 30
        && request.resource.data.favCount == 0
        && request.resource.data.downloadCount == 0
        && request.resource.data.status == 'active'
        && request.resource.data.listed == (request.resource.data.visibility == 'public');

      allow update:
        // El dueño edita la información, sin tocar contadores ni estado de moderación.
        if (signedIn()
            && resource.data.ownerId == request.auth.uid
            && request.resource.data.ownerId == resource.data.ownerId
            && request.resource.data.status == resource.data.status
            && request.resource.data.favCount == resource.data.favCount
            && request.resource.data.downloadCount == resource.data.downloadCount
            && request.resource.data.listed == (request.resource.data.visibility == 'public' && resource.data.status == 'active'))
        // Cualquier persona con sesión puede marcar o quitar favorito (+1 / -1).
        || (signedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['favCount'])
            && (request.resource.data.favCount - resource.data.favCount == 1
                || request.resource.data.favCount - resource.data.favCount == -1)
            && request.resource.data.favCount >= 0)
        // Y sumar una descarga.
        || (signedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloadCount'])
            && request.resource.data.downloadCount - resource.data.downloadCount == 1)
        || isAdmin();

      allow delete: if (signedIn() && resource.data.ownerId == request.auth.uid) || isAdmin();
    }

    match /favorites/{favId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && favId == request.auth.uid + '_' + request.resource.data.packId;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    match /reports/{id} {
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.reason in ['copyright', 'inappropriate', 'spam', 'other']
        && request.resource.data.details.size() <= 1000;
      allow read, update, delete: if isAdmin();
    }
  }
}
